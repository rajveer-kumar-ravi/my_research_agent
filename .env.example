# ==========================================================
# Intelligent Web Research Agent — Environment Configuration
# Copy this file to `.env` and fill in your own keys.
# NEVER commit your real .env file.
# ==========================================================

# --- Google Gemini API ---
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Web Search Provider (Tavily) ---
# Get a free developer key at: https://tavily.com
SEARCH_API_KEY=your_google_api_key_here

# --- App / server config ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- CORS ---
# Comma separated list of allowed origins for the frontend
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# --- Database ---
# For local (non-Docker) development, this file is used as-is.
# NOTE: when running via `docker compose up`, docker-compose.yml overrides
# this value to point at a persistent named volume automatically — you
# don't need to change it for Docker.
DATABASE_URL=sqlite:///./research_agent.db

# --- Research pipeline tuning ---
MAX_SUB_QUESTIONS=4
MAX_SEARCH_RESULTS_PER_QUERY=5
MAX_URLS_TO_SCRAPE=12
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
TOP_K_CHUNKS=10
EMBEDDING_MODEL=all-MiniLM-L6-v2
SCRAPE_TIMEOUT_SECONDS=10
HTTP_MAX_RETRIES=2

# --- Authentication ---
# Session validity (NOT account validity — accounts never expire).
AUTH_SESSION_DAYS=30
SESSION_COOKIE_NAME=session_token

# Google OAuth (Sign in with Google). Create credentials at
# https://console.cloud.google.com/apis/credentials — Authorized redirect
# URI must exactly match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
